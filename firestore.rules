rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/domains/{domainId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['concepts', 'projects'])
        && request.resource.data.concepts is map
        && request.resource.data.projects is map
        && request.resource.data.concepts.size() <= 500
        && request.resource.data.projects.size() <= 100;
    }
  }
}
