# Optional: leave Firebase values empty to use browser-local preview mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set this to your real production domain in Vercel for canonical URLs and sitemap generation.
VITE_SITE_URL=

# Set true only after enabling Vercel Web Analytics for the project.
VITE_ENABLE_ANALYTICS=false

# Optional real contact address shown in the site footer and navigation.
VITE_CONTACT_EMAIL=
